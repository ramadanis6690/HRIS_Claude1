# /etc/hris/env — pemilik root, mode 0600 (NFR-15). Dibaca systemd; JANGAN masuk git.
# Salin:  sudo install -m 0600 -o root -g root deploy/env.contoh /etc/hris/env
# lalu ganti setiap nilai GANTI_*.

# uji | asli
HRIS_LINGKUNGAN=asli

# Aplikasi tersambung sebagai hris_app (tanpa hak DELETE, tidak bisa mengubah Audit Log).
DATABASE_URL=postgres://hris_app:GANTI_SANDI_HRIS_APP@127.0.0.1:5432/hris
# Pemilik basis data — hanya untuk migrasi. Boleh dikosongkan di luar waktu deploy.
DATABASE_URL_PEMILIK=postgres://hris_pemilik:GANTI_SANDI_PEMILIK@127.0.0.1:5432/hris

HRIS_HOST=127.0.0.1
HRIS_PORT=3000
HRIS_DIR_BERKAS=/var/lib/hris
# Alamat publik persis seperti di browser, untuk menolak permintaan dari situs lain.
HRIS_ASAL_SAH=https://GANTI_NAMA_DOMAIN

# Backup (deploy/backup.sh)
# Tujuan di LUAR mesin ini: folder NAS yang di-mount, atau target rsync (user@host:/folder/).
HRIS_BACKUP_TUJUAN=/mnt/backup-hris
# ID kunci publik GPG penerima. Kunci privatnya disimpan IT di luar server ini.
HRIS_BACKUP_GPG_PENERIMA=GANTI_ID_KUNCI_GPG
HRIS_BACKUP_SIMPAN_HARI=30

# Hanya di ASLI: versi yang lulus di UJI, format "<os>|<pg mayor>|<node mayor>",
# mis. HRIS_VERSI_UJI="Ubuntu 24.04.5 LTS|16|22" (pakai tanda kutip).
# deploy.sh berhenti bila ASLI berbeda (NFR-13).
HRIS_VERSI_UJI=
