{
  "name": "hris-dpjm",
  "version": "0.1.0",
  "private": true,
  "description": "HRIS Dana Pensiun Jasa Marga — PostgreSQL 16 + Node 22 + React 19",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:client": "vite",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "start": "node dist/server/server/main.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:core": "vitest run test/core",
    "test:statis": "vitest run test/statis",
    "test:akses": "vitest run test/akses test/integrasi",
    "migrasi": "tsx scripts/migrasi.ts",
    "isi-contoh": "tsx scripts/isi-contoh.ts",
    "buat-super-admin": "tsx scripts/buat-super-admin.ts",
    "pekerjaan": "tsx src/server/pekerjaan/jalankan.ts",
    "siapkan-db-lokal": "bash scripts/siapkan-db-lokal.sh"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "exceljs": "4.4.0",
    "pdfkit": "0.20.2",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.5",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "leaflet": "1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
